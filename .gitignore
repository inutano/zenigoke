# Claude Code local settings (per-machine)
.claude/settings.local.json

# Large binary data lives outside the repo, but if anything leaks in:
/data1/
*.bam
*.bw
*.bb
*.fastq
*.fastq.gz
*.fa
*.fa.fai
*.abismal.idx

# Scratch / logs
tmp/
logs/
report/*.html
!report/bundle.html
!report/enrichment.html

# Transient fetched XML (provenance kept on disk, not in git)
metadata/biosamples/*.xml
metadata/experiments/

# Catalog DB (build artifact, rebuilt from source)
db/*.db

# Symlink to pipeline output (served via HTTP; target is outside the repo)
report/output
.superpowers/
report/bundles/

# web UI (web/): generated at deploy time by web/make_index.py
web/data/catalog.json

# scripts/assemble-site.sh output (CI publishes it; local previews only)
/site/
